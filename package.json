{
  "name": "practice-pages-demidov",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "json-server --watch src/server/db/index.cjs --routes src/server/routes.json --port 3001",
    "build": "tsc && vite build && node scripts/save-json-api.cjs",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "json-server": "0.17.4",
    "gh-pages": "6.3.0"
  }
}
